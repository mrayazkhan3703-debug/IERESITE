  userId          String?
  sessionKey      String?  // SHA-256 hash of the HttpOnly anonymous AI-session cookie
  locale          String   @default("en")
  status          String   @default("ACTIVE") // ACTIVE|ENDED|HANDED_OFF|ABANDONED
  topicSummary    String?
  messageCount    Int      @default(0)
