// Investment Experts — Canonical Real-Estate Data Model
// Source of truth: Master Blueprint PART C (C001–C092).
// Environment adaptations documented in docs/ARCHITECTURE_DECISIONS.md (ADR-002, ADR-009):
//  - PostgreSQL-backed; string codes remain validated by zod at service boundary
//  - Operational envelopes use JSONB; legacy presentation JSON remains typed text until migrated with its owner
//  - Money: BigInt minor units (ISO-4217 `currency`); serialized as string (ADR-009)
//  - Geo: numeric lat/lng plus PostGIS geography with explicit precision and provenance
//  - Instants use timestamptz; calendar-only business dates use date
//  - Opaque cuid ids + separate slug for SEO routes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// C001–C007 Organizations, users, RBAC
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  legalName String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users          User[]
  leads          Lead[]
  auditLogs      AuditLog[]
  crmSyncRecords CrmSyncRecord[]
  ownedProperties Property[]   @relation("PropertyOwner")
  ownedProjects   Project[]    @relation("ProjectOwner")
  ownedDevelopers Developer[] @relation("DeveloperOwner")
  ownedCommunities Community[] @relation("CommunityOwner")
  ownedAgents      Agent[] @relation("AgentOwner")
  invitations      UserInvitation[]
}

model User {
  id             String    @id @default(cuid())
  organizationId String?
  email          String    @unique
  emailVerified  DateTime? @db.Timestamptz(3)
  passwordHash   String?
  name           String?
  isActive       Boolean   @default(true)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz(3)
  lastLoginAt    DateTime? @db.Timestamptz(3)
  mfaSecretCiphertext String?
  mfaEnabledAt     DateTime? @db.Timestamptz(3)
  mfaRecoveryCodesJson String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization       Organization?              @relation(fields: [organizationId], references: [id])
  profile            UserProfile?
  roles              UserRole[]
  sessions           Session[]
  accountTokens      AccountToken[]
  favorites          Favorite[]
  savedSearches      SavedSearch[]
  comparisons        Comparison[]
  recentlyViewed     RecentlyViewed[]
  notifications      Notification[]
  notifSubs          NotificationSubscription[]
  aiConversations    AiConversation[]
  dataSubjectReqs    DataSubjectRequest[]
  consents           Consent[]
  agent              Agent?
  auditLogs          AuditLog[]
  portfolioHoldings  PortfolioHolding[]
  portfolioDocuments PortfolioDocument[]
  sentInvitations    UserInvitation[] @relation("UserInvitationInviter")

  @@index([organizationId])
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  phone           String?
  locale          String   @default("en")
  currency        String   @default("AED")
  marketingOptIn  Boolean  @default(false)
  preferencesJson String? // JSON: {bedrooms, communities[], priceBand, ...}
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id              String           @id @default(cuid())
  key             String           @unique // OWNER|ADMIN|MANAGER|CONTENT_EDITOR|AGENT|ANALYST|CUSTOMER|VIEWER
  name            String
  description     String?
  rolePermissions RolePermission[]
  users           UserRole[]
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique // e.g. property:publish, lead:assign
  description     String?
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  grantedAt DateTime @default(now()) @db.Timestamptz(3)
  grantedBy String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserInvitation {
  id             String   @id @default(cuid())
  email          String
  organizationId String
  roleKey        String
  invitedBy      String
  tokenHash      String   @unique
  expiresAt      DateTime @db.Timestamptz(3)
  acceptedAt     DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("UserInvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict)

  @@index([email, createdAt])
  @@index([organizationId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipHash    String?
  expiresAt DateTime @db.Timestamptz(3)
  rotatedAt DateTime @default(now()) @db.Timestamptz(3)
  mfaVerifiedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AccountToken {
  id           String    @id @default(cuid())
  userId       String
  purpose      String    // VERIFY_EMAIL|RESET_PASSWORD|CHANGE_EMAIL|MFA_SETUP|MFA_LOGIN
  tokenHash    String    @unique
  pendingValue String?
  expiresAt    DateTime  @db.Timestamptz(3)
  usedAt       DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

// ============================================================
// C008–C011 Agents
// ============================================================

model Agent {
  ownerOrganizationId String?
  publicTeam Boolean @default(false)
  ownerOrganization Organization? @relation("AgentOwner", fields: [ownerOrganizationId], references: [id], onDelete: Restrict)
  @@index([ownerOrganizationId])
  id                String   @id @default(cuid())
  userId            String?  @unique
  name              String
  slug              String   @unique
  jobTitle          String   @default("Property Consultant")
  bio               String   @default("")
  photoMediaId      String?
  phoneE164         String?
  whatsappE164      String?
  email             String?
  languagesJson     String? // JSON [{code, name, fluency}]
  specialtiesJson   String? // JSON [specialty codes] (mirror join table)
  communitiesJson   String? // JSON [community ids] (mirror for fast read)
  yearsExperience   Int      @default(0)
  active            Boolean  @default(true)
  leadCapacityState String   @default("AVAILABLE") // AVAILABLE|LOW|HIGH — LEGACY (V3-02): unverified, UI must not display
  leadCapacityNote  String?
  sortWeight        Int      @default(0)
  isDemoData        Boolean  @default(false)
  sourceType        String   @default("INTERNAL")
  /* V3-02 (V3 §11/§12) — verified team data, additive only:
   * department: leadership|sales|marketing|hr|admin|other (team grouping)
   * publicAdvisor: member appears on /agents (public advisory directory)
   * phoneDisplay: human-readable display form of phoneE164
   * photoUrl: direct static asset path (e.g. /images/team/member-01.jpg);
   *   photoMediaId stays untouched for media-registry-managed photos. */
  department        String? // leadership|sales|marketing|hr|admin|other
  publicAdvisor     Boolean  @default(false)
  phoneDisplay      String?
  photoUrl          String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  user            User?            @relation(fields: [userId], references: [id])
  listings        Listing[]
  leadAssignments LeadAssignment[]
  communities     AgentCommunity[]
  languageRecords AgentLanguage[]
  specialtyRecords AgentSpecialty[]
  viewings        Viewing[]
  bookings        Booking[]
  ownedLeads      Lead[]

  @@index([active])
}

model AgentLanguage {
  id        String   @id @default(cuid())
  agentId   String
  code      String // ISO 639-1
  name      String
  fluency   String   @default("FLUENT") // BASIC|CONVERSATIONAL|FLUENT|NATIVE
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, code])
}

model AgentSpecialty {
  id        String   @id @default(cuid())
  agentId   String
  specialty String // OFF_PLAN|LUXURY|INVESTMENT|SECONDARY|COMMERCIAL|RELOCATION...
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, specialty])
}

model AgentCommunity {
  id          String   @id @default(cuid())
  agentId     String
  communityId String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([agentId, communityId])
}

// ============================================================
// C012–C018 Contacts & Leads
// ============================================================

model Contact {
  id          String   @id @default(cuid())
  email       String?
  phoneE164   String?
  name        String?
  dedupeKey   String   @unique // normalized email or phone
  locale      String   @default("en")
  firstSeenAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  leads               Lead[]
  consents            LeadConsent[]
  privacyConsents     Consent[]
  dataSubjectRequests DataSubjectRequest[]

  @@index([email])
  @@index([phoneE164])
}

model Lead {
  id                  String    @id @default(cuid())
  organizationId      String?
  contactId           String
  intent              String    @default("BUY") // BUY|RENT|INVEST|SELL|LIST|VALUATION|CONSULT|GENERAL
  status              String    @default("NEW") // NEW|ATTEMPTED|CONTACTED|QUALIFIED|NURTURE|WON|LOST|SPAM
  sourceChannel       String    @default("WEBSITE") // WEBSITE|WHATSAPP|PHONE|AI_ADVISOR|REFERRAL|CAMPAIGN
  primaryEntityType   String? // PROPERTY|PROJECT|COMMUNITY|DEVELOPER|AGENT|MARKET_REPORT|GUIDE
  primaryEntityId     String?
  primaryEntitySlug   String?
  ownerAgentId        String?
  assignedAt          DateTime? @db.Timestamptz(3)
  message             String?
  preferredLocale     String?
  budgetMinMinor      BigInt?
  budgetMaxMinor      BigInt?
  currency            String    @default("AED")
  dedupeKey           String? // idempotency for form resubmission
  isDemoData          Boolean   @default(false)
  /**
   * U16 (§26) additive: structured seller/listing property details captured by
   * the multi-step list-property funnel (location/building/type/beds/size/status…).
   */
  propertyDetailsJson String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  organization   Organization?    @relation(fields: [organizationId], references: [id])
  contact        Contact          @relation(fields: [contactId], references: [id])
  ownerAgent     Agent?           @relation(fields: [ownerAgentId], references: [id])
  context        LeadContext?
  events         LeadEvent[]
  assignments    LeadAssignment[]
  scores         LeadScore[]
  consents       LeadConsent[]
  crmSyncRecords CrmSyncRecord[]
  booking        Booking?
  viewing        Viewing?
  inquiries      Inquiry[]

  @@index([status])
  @@index([contactId])
  @@index([createdAt])
  @@index([dedupeKey])
  @@index([organizationId, createdAt])
}

model LeadContext {
  leadId           String  @id
  landingUrl       String?
  referrer         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  searchStateJson  String? // serialized SearchState at submission
  sessionId        String?
  locale           String  @default("en")
  deviceClass      String? // MOBILE|TABLET|DESKTOP
  pagePath         String?
  aiConversationId String?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadEvent {
  id          String   @id @default(cuid())
  leadId      String
  eventType   String // CREATED|STATUS_CHANGED|ASSIGNED|NOTE|CRM_DELIVERED|CRM_FAILED|VIEWED|CONTACTED...
  payloadJson String?
  actorType   String   @default("SYSTEM") // SYSTEM|USER|AGENT|AI
  actorId     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadAssignment {
  id         String   @id @default(cuid())
  leadId     String
  agentId    String
  assignedAt DateTime @default(now()) @db.Timestamptz(3)
  assignedBy String?
  reason     String? // ROUND_ROBIN|SPECIALTY|AGENT_PROFILE|MANUAL|AI_HANDOFF
  active     Boolean  @default(true)

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id])

  @@index([leadId])
}

model LeadScore {
  id           String   @id @default(cuid())
  leadId       String
  score        Int
  band         String   @default("MEDIUM") // LOW|MEDIUM|HIGH
  modelVersion String   @default("v1-deterministic")
  reasonsJson  String? // JSON [{factor, weight}]
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadConsent {
  id            String    @id @default(cuid())
  leadId        String
  contactId     String?
  purpose       String    @default("LEAD_CONTACT") // LEAD_CONTACT|MARKETING|WHATSAPP|NEWSLETTER|ANALYTICS
  status        String    @default("GRANTED") // GRANTED|DENIED|WITHDRAWN
  policyVersion String    @default("2026-09-v1")
  evidenceJson  String? // {formId, checkboxLabel, timestamp}
  capturedAt    DateTime  @default(now()) @db.Timestamptz(3)
  withdrawnAt   DateTime? @db.Timestamptz(3)

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([leadId])
}

// ============================================================
// C019–C025 Canonical property core
// ============================================================

model Property {
  id                String    @id @default(cuid())
  ownerOrganizationId String?
  projectId         String?
  communityId       String
  developerId       String?
  title             String
  slug              String    @unique
  propertyType      String    @default("APARTMENT") // APARTMENT|VILLA|TOWNHOUSE|PENTHOUSE|DUPLEX|STUDIO|OFFICE|RETAIL|PLOT
  subType           String?
  bedrooms          Float     @default(0) // 0 = studio; 0.5 for " convert" odd cases
  bathrooms         Float     @default(0)
  builtUpAreaSqft   Float?
  plotAreaSqft      Float?
  furnishing        String? // FURNISHED|SEMI_FURNISHED|UNFURNISHED
  view              String? // SEA|MARINA|SKYLINE|GOLF|PARK|COMMUNITY
  floor             Int?
  totalFloors       Int?
  handoverQuarter   String? // for off-plan e.g. "Q4 2027"
  titleDeedRef      String?
  reraPermit        String? // Dubai RERA permit number (validation ready)
  lat               Float
  lng               Float
  addressLine       String?
  shortDescription  String?
  description       String?
  highlightsJson    String? // JSON string[]
  publicationStatus String    @default("DRAFT") // DRAFT|PUBLISHED|ARCHIVED|UNPUBLISHED
  sourceType        String    @default("INTERNAL") // INTERNAL|IMPORT|DEMO_SEED
  sourceId          String? // external system key (idempotency)
  sourceUpdatedAt   DateTime? @db.Timestamptz(3)
  retrievedAt       DateTime? @db.Timestamptz(3)
  sourceSnapshotJson String? // Latest normalized provider record, retained separately from Admin overrides
  editorOverridesJson String? // Explicit editorial values that take precedence over source facts
  locationPrecision String    @default("UNAVAILABLE") // EXACT|BUILDING|PROJECT|COMMUNITY_CENTROID|APPROXIMATE|UNAVAILABLE
  locationSourceType String?
  locationSourceId   String?
  geo               Unsupported("geography(Point,4326)")?
  contentHash       String? // change detection for imports
  isDemoData        Boolean   @default(false)
  deletedAt         DateTime? @db.Timestamptz(3)
  createdBy         String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  project           Project?            @relation(fields: [projectId], references: [id])
  community         Community           @relation(fields: [communityId], references: [id])
  developer         Developer?          @relation(fields: [developerId], references: [id])
  ownerOrganization Organization?       @relation("PropertyOwner", fields: [ownerOrganizationId], references: [id], onDelete: SetNull)
  units             PropertyUnit[]
  listings          Listing[]
  priceHistory      PriceHistory[]
  media             PropertyMedia[]
  floorPlans        PropertyFloorPlan[]
  documents         PropertyDocument[]
  amenities         PropertyAmenity[]
  favorites         Favorite[]
  recentlyViewed    RecentlyViewed[]
  comparisons       ComparisonItem[]
  availabilities    Availability[]
  viewings          Viewing[]
  importRecords     ImportRecord[]
  dataQualityIssues DataQualityIssue[]
  portfolioHoldings PortfolioHolding[]

  @@index([communityId])
  @@index([projectId])
  @@index([publicationStatus])
  @@index([sourceType, sourceId])
  @@index([ownerOrganizationId])
  @@index([deletedAt])
  @@index([geo], type: Gist)
}

model PropertyUnit {
  id                 String   @id @default(cuid())
  propertyId         String?
  projectId          String?
  unitNumber         String?
  unitType           String   @default("APARTMENT")
  bedrooms           Float    @default(0)
  bathrooms          Float    @default(0)
  areaSqft           Float?
  priceMinor         BigInt?
  currency           String   @default("AED")
  availabilityStatus String   @default("AVAILABLE") // AVAILABLE|RESERVED|SOLD|RENTED|HELD
  floor              Int?
  aspect             String?
  sourceType         String   @default("MANUAL") // MANUAL|IMPORT
  sourceKey           String?
  sourceSnapshotJson String?
  editorOverridesJson String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusHistory PropertyUnitStatusHistory[]

  @@index([projectId])
  @@index([propertyId])
  @@unique([projectId, sourceKey])
}

model PropertyUnitStatusHistory {
  id         String   @id @default(cuid())
  unitId     String
  fromStatus String?
  toStatus   String
  reason     String?
  changedBy  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  unit PropertyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, createdAt])
}

model Listing {
  id                   String    @id @default(cuid())
  propertyId           String
  listingType          String    @default("SALE") // SALE|RENT|SHORT_TERM
  tenure               String? // FREEHOLD|LEASEHOLD
  priceMinor           BigInt
  priceQualifier       String? // e.g. "From", "Guide price"
  currency             String    @default("AED")
  rentFrequency        String? // YEARLY|MONTHLY|WEEKLY|DAILY (rent only)
  serviceChargePerSqft Float?
  sourceSnapshotJson   String? // Latest normalized provider listing facts
  editorOverridesJson  String? // Explicit Admin overrides keyed by source field
  availabilityStatus   String    @default("AVAILABLE") // AVAILABLE|RESERVED|SOLD|RENTED|HELD|WITHDRAWN
  offPlan              Boolean   @default(false)
  isFeatured           Boolean   @default(false)
  isExclusive          Boolean   @default(false)
  agentId              String?
  publishedAt          DateTime? @db.Timestamptz(3)
  expiresAt            DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  property      Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agent         Agent?                 @relation(fields: [agentId], references: [id])
  statusHistory ListingStatusHistory[]
  priceHistory  PriceHistory[]
  importRecords ImportRecord[]

  @@index([listingType, availabilityStatus])
  @@index([propertyId])
  @@index([isFeatured])
}

model ListingStatusHistory {
  id         String   @id @default(cuid())
  listingId  String
  fromStatus String?
  toStatus   String
  reason     String?
  changedBy  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model PriceHistory {
  id         String   @id @default(cuid())
  propertyId String
  listingId  String?
  priceMinor BigInt
  currency   String   @default("AED")
  sourceType String   @default("INTERNAL")
  recordedAt DateTime @default(now()) @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([propertyId, recordedAt])
}

model Availability {
  id         String    @id @default(cuid())
  propertyId String
  status     String // AVAILABLE|RESERVED|SOLD|RENTED|HELD|WITHDRAWN
  note       String?
  from       DateTime  @default(now()) @db.Timestamptz(3)
  to         DateTime? @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// ============================================================
// C026–C032 Projects, developers, communities, geo
// ============================================================

model Project {
  id                           String    @id @default(cuid())
  ownerOrganizationId          String?
  developerId                  String
  communityId                  String
  name                         String
  slug                         String    @unique
  tagline                      String?
  summary                      String?
  description                  String?
  status                       String    @default("OFF_PLAN") // OFF_PLAN|UNDER_CONSTRUCTION|READY|COMPLETED|CANCELLED|ON_HOLD
  projectType                  String    @default("RESIDENTIAL") // RESIDENTIAL|MIXED_USE|HOSPITALITY|COMMERCIAL
  launchDate                   DateTime? @db.Date
  handoverDate                 DateTime? @db.Date
  completionPercent            Float?
  constructionStatus           String?
  constructionSourceUrl        String?
  constructionSourceVerifiedAt DateTime? @db.Timestamptz(3)
  totalUnits                   Int?
  startingPriceMinor           BigInt?
  currency                     String    @default("AED")
  lat                          Float
  lng                          Float
  brochureMediaId              String?
  keyAmenitiesJson             String?
  highlightsJson               String?
  publicationStatus            String    @default("DRAFT") // DRAFT|PUBLISHED|ARCHIVED
  sourceType                   String    @default("INTERNAL")
  sourceId                     String?
  sourceVerifiedAt             DateTime? @db.Timestamptz(3)
  sourceUpdatedAt              DateTime? @db.Timestamptz(3)
  retrievedAt                  DateTime? @db.Timestamptz(3)
  locationPrecision            String    @default("UNAVAILABLE") // EXACT|BUILDING|PROJECT|COMMUNITY_CENTROID|APPROXIMATE|UNAVAILABLE
  locationSourceType           String?
  locationSourceId             String?
  geo                          Unsupported("geography(Point,4326)")?
  contentHash                  String?
  isDemoData                   Boolean   @default(false)
  deletedAt                    DateTime? @db.Timestamptz(3)
  createdAt                    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime  @updatedAt @db.Timestamptz(3)

  developer         Developer              @relation(fields: [developerId], references: [id])
  community         Community              @relation(fields: [communityId], references: [id])
  ownerOrganization Organization?          @relation("ProjectOwner", fields: [ownerOrganizationId], references: [id], onDelete: SetNull)
  properties        Property[]
  units             PropertyUnit[]
  paymentPlans      PaymentPlan[]
  media             ProjectMedia[]
  amenities         ProjectAmenity[]
  statusHistory     ProjectStatusHistory[]
  importRecords     ImportRecord[]
  documents         PropertyDocument[]
  portfolioHoldings PortfolioHolding[]

  @@index([developerId])
  @@index([communityId])
  @@index([status])
  @@index([publicationStatus])
  @@index([geo], type: Gist)
  @@index([ownerOrganizationId])
}

model ProjectStatusHistory {
  id         String   @id @default(cuid())
  projectId  String
  fromStatus String?
  toStatus   String
  reason     String?
  changedBy  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Developer {
  id                 String    @id @default(cuid())
  ownerOrganizationId String?
  name               String
  slug               String    @unique
  summary            String?
  description        String?
  websiteUrl         String?
  logoMediaId        String?
  headquarters       String?
  foundedYear        Int?
  verificationStatus String    @default("UNVERIFIED") // UNVERIFIED|PUBLIC_RECORDS|VERIFIED
  verificationEvidenceUrl String?
  lastVerifiedAt     DateTime? @db.Timestamptz(3)
  sourceUpdatedAt    DateTime? @db.Timestamptz(3)
  retrievedAt        DateTime? @db.Timestamptz(3)
  sourceType         String    @default("INTERNAL")
  isDemoData         Boolean   @default(false)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  projects   Project[]
  properties Property[]
  ownerOrganization Organization? @relation("DeveloperOwner", fields: [ownerOrganizationId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([ownerOrganizationId])
}

model Community {
  id                   String   @id @default(cuid())
  ownerOrganizationId  String?
  parentLocationId     String?
  name                 String
  slug                 String   @unique
  summary              String?
  description          String?
  areaType             String   @default("RESIDENTIAL") // RESIDENTIAL|BUSINESS|WATERFRONT|ISLAND|SUBURBAN|INDUSTRIAL
  lat                  Float
  lng                  Float
  boundaryJson         String? // GeoJSON polygon (simplified)
  radiusMeters         Int      @default(2500)
  avgPricePerSqftMinor BigInt?
  currency             String   @default("AED")
  lifestyleTagsJson    String?
  transportJson        String? // JSON [{type, name, distance}]
  schoolsJson          String?
  healthcareJson       String?
  retailJson           String?
  imageMediaId         String?
  publicationStatus    String   @default("PUBLISHED")
  sourceType           String   @default("INTERNAL")
  sourceUpdatedAt      DateTime? @db.Timestamptz(3)
  retrievedAt          DateTime? @db.Timestamptz(3)
  locationPrecision    String   @default("UNAVAILABLE") // EXACT|COMMUNITY_CENTROID|APPROXIMATE|UNAVAILABLE
  locationSourceType   String?
  locationSourceId     String?
  geo                  Unsupported("geography(Point,4326)")?
  isDemoData           Boolean  @default(false)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  parentLocation     Location?           @relation(fields: [parentLocationId], references: [id])
  ownerOrganization Organization?        @relation("CommunityOwner", fields: [ownerOrganizationId], references: [id], onDelete: SetNull)
  properties         Property[]
  projects           Project[]
  agents             AgentCommunity[]
  boundary           LocationBoundary?
  marketMetrics      MarketMetric[]
  marketTransactions MarketTransaction[]
  marketRents        MarketRent[]
  buildings          Building[]

  @@index([publicationStatus])
  @@index([geo], type: Gist)
  @@index([ownerOrganizationId])
}

model Location {
  id        String   @id @default(cuid())
  parentId  String?
  name      String
  slug      String   @unique
  level     String   @default("COMMUNITY") // EMIRATE|SECTOR|AREA|COMMUNITY|SUBCOMMUNITY
  lat       Float?
  lng       Float?
  path      String? // materialized path for hierarchy
  sourceType String   @default("INTERNAL")
  sourceUpdatedAt DateTime? @db.Timestamptz(3)
  retrievedAt DateTime? @db.Timestamptz(3)
  locationPrecision String @default("UNAVAILABLE")
  locationSourceType String?
  locationSourceId String?
  geo       Unsupported("geography(Point,4326)")?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  parent      Location?   @relation("LocationTree", fields: [parentId], references: [id])
  children    Location[]  @relation("LocationTree")
  communities Community[]
  boundary    LocationBoundary?

  @@index([parentId])
  @@index([geo], type: Gist)
}

model LocationBoundary {
  id          String   @id @default(cuid())
  locationId  String?  @unique
  communityId String?  @unique
  geoJson     String // GeoJSON polygon string
  boundaryGeo Unsupported("geography(Polygon,4326)")?
  sourceType  String   @default("INTERNAL")
  sourceUpdatedAt DateTime? @db.Timestamptz(3)
  retrievedAt DateTime? @db.Timestamptz(3)
  simplified  Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  community Community? @relation(fields: [communityId], references: [id])
  location  Location?  @relation(fields: [locationId], references: [id])

  @@index([boundaryGeo], type: Gist)
}

model Building {
  id                   String   @id @default(cuid())
  communityId          String
  name                 String
  slug                 String?
  floors               Int?
  yearBuilt            Int?
  lat                  Float?
  lng                  Float?
  serviceChargePerSqft Float?
  sourceType           String   @default("INTERNAL")
  sourceUpdatedAt      DateTime? @db.Timestamptz(3)
  retrievedAt          DateTime? @db.Timestamptz(3)
  locationPrecision    String   @default("UNAVAILABLE")
  locationSourceType   String?
  locationSourceId     String?
  geo                  Unsupported("geography(Point,4326)")?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  community Community @relation(fields: [communityId], references: [id])

  @@index([communityId])
  @@index([geo], type: Gist)
}

// ============================================================
// C033–C038 Amenities & media
// ============================================================

model Amenity {
  id       String  @id @default(cuid())
  key      String  @unique // POOL|GYM|BEACH_ACCESS|...
  name     String
  category String  @default("BUILDING") // BUILDING|UNIT|OUTDOOR|SERVICE
  icon     String?

  propertyAmenities PropertyAmenity[]
  projectAmenities  ProjectAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  note       String?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model ProjectAmenity {
  projectId String
  amenityId String
  note      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([projectId, amenityId])
}

// Generic media asset registry (storage abstraction ADR — local FS here)
model MediaAsset {
  id           String   @id @default(cuid())
  kind         String   @default("IMAGE") // IMAGE|VIDEO|FLOOR_PLAN|DOCUMENT|BROCHURE|LOGO
  originalFilename String?
  storageKey   String   @unique // path under public/uploads
  url          String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String?
  caption      String?
  posterMediaId String?
  poster        MediaAsset? @relation("VideoPoster", fields: [posterMediaId], references: [id], onDelete: Restrict)
  posterFor     MediaAsset[] @relation("VideoPoster")
  variantsJson String? // JSON {thumb, card, hero, webp...}
  checksum     String?
  exifStripped Boolean  @default(true)
  isPrivate    Boolean  @default(false)
  uploadedBy   String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  processingJobs     MediaProcessingJob[]
  propertyMedia      PropertyMedia[]
  projectMedia       ProjectMedia[]
  floorPlans         PropertyFloorPlan[]
  documents          PropertyDocument[]
  portfolioDocuments PortfolioDocument[]

  @@index([kind])
  @@index([isPrivate])
  @@index([posterMediaId])
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  mediaId    String
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  altText    String?
  caption    String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  property Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id])

  @@index([propertyId, sortOrder])
}

// Short-lived download permission issued only after the entity's consent gate.
model MediaDownloadGrant {
  tokenHash String @id
  mediaId String
  sourceType String
  sourceId String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([expiresAt])
}

model ProjectMedia {
  id        String   @id @default(cuid())
  projectId String
  mediaId   String
  section   String   @default("GALLERY") // GALLERY|PROGRESS|BROCHURE
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  altText   String?
  caption   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id])

  @@index([projectId, sortOrder])
}

model PropertyFloorPlan {
  id         String   @id @default(cuid())
  propertyId String
  mediaId    String
  bedrooms   Float?
  areaSqft   Float?
  priceMinor BigInt?
  currency   String   @default("AED")
  label      String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  property Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id])

  @@index([propertyId])
}

model PropertyDocument {
  id            String   @id @default(cuid())
  propertyId    String?
  projectId     String?
  mediaId       String
  docType       String   @default("BROCHURE") // BROCHURE|FLOOR_PLAN_PACK|TITLE_DEED|ESCALATION|OTHER
  label         String?
  gated         Boolean  @default(false) // requires lead capture to download
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  property Property?  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  project  Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id])

  @@index([propertyId])
  @@index([projectId])
}

// ============================================================
// C039–C040 Payment plans
// ============================================================

model PaymentPlan {
  id                 String    @id @default(cuid())
  projectId          String
  name               String    @default("Standard Payment Plan")
  currency           String    @default("AED")
  totalPercent       Float     @default(100)
  postHandover       Boolean   @default(false)
  sourceDocumentId   String?
  verificationStatus String    @default("UNVERIFIED") // UNVERIFIED|PUBLISHED|VERIFIED
  validFrom          DateTime? @db.Date
  validTo            DateTime? @db.Date
  notes              String?
  isDefault          Boolean   @default(false)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installments PaymentPlanInstallment[]

  @@index([projectId])
}

model PaymentPlanInstallment {
  id              String   @id @default(cuid())
  paymentPlanId   String
  sequence        Int
  label           String // "Booking", "During construction", "On handover"
  percent         Float
  dueOffsetMonths Int? // months from booking or handover (negative = post-handover)
  amountMinor     BigInt? // optional absolute amount
  currency        String   @default("AED")
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@unique([paymentPlanId, sequence])
}

// ============================================================
// C041–C043 Viewings, bookings, inquiries
// ============================================================

model Viewing {
  id          String   @id @default(cuid())
  leadId      String   @unique
  agentId     String?
  propertyId  String?
  projectId   String?
  scheduledAt DateTime @db.Timestamptz(3)
  durationMin Int      @default(30)
  channel     String   @default("IN_PERSON") // IN_PERSON|VIDEO_CALL|PHONE
  status      String   @default("REQUESTED") // REQUESTED|CONFIRMED|COMPLETED|CANCELLED|NO_SHOW
  notes       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  lead     Lead      @relation(fields: [leadId], references: [id])
  agent    Agent?    @relation(fields: [agentId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@index([scheduledAt])
  @@index([status])
}

model Booking {
  id          String   @id @default(cuid())
  leadId      String   @unique
  bookingType String   @default("CONSULTATION") // CONSULTATION|VIEWING|CALLBACK
  agentId     String?
  scheduledAt DateTime @db.Timestamptz(3)
  durationMin Int      @default(30)
  channel     String   @default("OFFICE") // OFFICE|VIDEO|PHONE|WHATSAPP
  topic       String?
  status      String   @default("REQUESTED") // REQUESTED|CONFIRMED|COMPLETED|CANCELLED
  reference   String   @unique
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id])
  agent Agent? @relation(fields: [agentId], references: [id])

  @@index([scheduledAt])
}

model Inquiry {
  id         String   @id @default(cuid())
  leadId     String?
  entityType String
  entityId   String
  message    String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

// ============================================================
// C044–C048 Saved state
// ============================================================

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model SavedSearch {
  id              String    @id @default(cuid())
  userId          String
  name            String?
  searchStateJson String // serialized canonical SearchState
  alertConsent    Boolean   @default(false)
  alertFrequency  String    @default("WEEKLY") // INSTANT|DAILY|WEEKLY|MONTHLY
  lastMatchCount  Int       @default(0)
  lastMatchedAt   DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Comparison {
  id        String   @id @default(cuid())
  userId    String
  name      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ComparisonItem[]

  @@index([userId])
}

model ComparisonItem {
  id           String @id @default(cuid())
  comparisonId String
  propertyId   String
  sortOrder    Int    @default(0)

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, propertyId])
}

model RecentlyViewed {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  viewedAt   DateTime @default(now()) @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

// ============================================================
// C049–C050 Notifications
// ============================================================

model NotificationSubscription {
  id               String    @id @default(cuid())
  userId           String
  channel          String    @default("EMAIL") // EMAIL|WHATSAPP|SMS|BROWSER
  purpose          String    @default("SAVED_SEARCH_MATCH") // SAVED_SEARCH_MATCH|PRICE_CHANGE|NEW_LISTINGS|VIEWING_UPDATES|MARKETING
  consentGrantedAt DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, purpose])
}

model Notification {
  id             String    @id @default(cuid())
  userId         String
  kind           String    @default("SAVED_SEARCH_MATCH") // SAVED_SEARCH_MATCH|PRICE_CHANGE|VIEWING_CONFIRMED|LEAD_STATUS|SYSTEM
  title          String
  body           String
  payloadJson    String?
  readAt         DateTime? @db.Timestamptz(3)
  deliveredAt    DateTime? @db.Timestamptz(3)
  deliveryStatus String    @default("QUEUED") // QUEUED|SENT|FAILED|SKIPPED
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ============================================================
// C056–C057 Investor portfolio (V2 §25.6 — U15 additive)
// ============================================================

/**
 * A property the signed-in user holds (or intends to track). propertyId is
 * nullable so off-platform assets can be tracked with manual inputs; projectId
 * is nullable and links off-plan holdings to a platform project for payment
 * schedule (§25.4) and construction tracking (§25.5). All rows are strictly
 * user-scoped (server-side session filter — V1 RBAC semantics).
 */
model PortfolioHolding {
  id                   String    @id @default(cuid())
  userId               String
  propertyId           String?
  projectId            String?
  label                String
  purchasePriceMinor   BigInt
  purchaseDate         DateTime? @db.Date
  rentAnnualMinor      BigInt?
  sizeSqft             Float?
  serviceChargePerSqft Float?
  /**
   * JSON: { balanceMinor?: string, monthlyPaymentMinor?: string, ratePct?: number, termYears?: number }
   */
  mortgageJson         String?
  notes                String?
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  property  Property?           @relation(fields: [propertyId], references: [id])
  project   Project?            @relation(fields: [projectId], references: [id])
  documents PortfolioDocument[]

  @@index([userId])
  @@index([propertyId])
  @@index([projectId])
}

/**
 * Owner-uploaded portfolio documents (§25.6): SPA / title deed / Oqood /
 * receipts / floor plan / mortgage / tenancy. Media goes through the existing
 * upload pipeline (magic-byte sniffing, size caps); authorization is strict —
 * GET only ever returns the owner's own rows.
 */
model PortfolioDocument {
  id           String   @id @default(cuid())
  userId       String
  holdingId    String?
  category     String // SPA|TITLE_DEED|OQOOD|RECEIPT|FLOOR_PLAN|MORTGAGE|TENANCY
  mediaAssetId String
  label        String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  holding PortfolioHolding? @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  media   MediaAsset        @relation(fields: [mediaAssetId], references: [id])

  @@index([userId])
  @@index([holdingId])
}

// ============================================================
// C051–C055 Sessions, search analytics, attribution
// ============================================================

model WebsiteSession {
  id          String    @id @default(cuid())
  sessionKey  String    @unique
  firstSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz(3)
  landingPath String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  deviceClass String?
  locale      String    @default("en")
  ipHash      String?
  closedAt    DateTime? @db.Timestamptz(3)

  touchpoints AttributionTouchpoint[]
  events      AnalyticsEvent[]

  @@index([lastSeenAt])
}

model SearchQuery {
  id             String   @id @default(cuid())
  queryText      String
  normalizedText String
  resultCount    Int?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  searchEvents SearchEvent[]
}

/// Rebuildable public-search projection. Canonical property/listing tables remain
/// the source of truth; worker/outbox handlers replace stale documents.
model SearchDocument {
  listingId                 String   @id
  propertyId                String
  slug                      String
  title                     String
  normalizedText            String
  searchVector              Unsupported("tsvector")? @map("search_vector")
  listingType               String
  propertyType              String
  bedrooms                  Float
  bathrooms                 Float
  areaSqft                  Float?
  priceMinor                BigInt
  currency                  String
  priceQualifier            String?
  rentFrequency             String?
  availabilityStatus        String
  offPlan                   Boolean
  isFeatured                Boolean
  isExclusive               Boolean
  furnished                 Boolean
  furnishing                String?
  communityId               String
  communityName             String
  communitySlug             String
  communityAreaType         String
  communityAvgPsqft         Float?
  communityYieldPct         Float?
  projectId                 String?
  projectName               String?
  projectSlug               String?
  projectStatus             String?
  developerId               String?
  developerName             String?
  developerSlug             String?
  agentId                   String?
  agentSlug                 String?
  amenities                 String[] @default([])
  lat                       Float
  lng                       Float
  geo                       Unsupported("geography(Point,4326)")?
  publishedAt               DateTime? @db.Timestamptz(3)
  handoverQuarter           String?
  view                      String?
  coverUrl                  String?
  coverAlt                  String?
  coverWidth                Int?
  coverHeight               Int?
  paymentPlanDownPercent    Float?
  paymentPlanPostHandover   Boolean?
  isDemoData                Boolean
  updatedAt                 DateTime @updatedAt @db.Timestamptz(3)

  @@index([propertyId])
  @@index([listingType, availabilityStatus])
  @@index([communitySlug])
  @@index([propertyType])
  @@index([developerSlug])
  @@index([priceMinor])
  @@index([bedrooms])
  @@index([publishedAt])
}

model SearchEvent {
  id              String   @id @default(cuid())
  sessionId       String?
  userId          String?
  queryId         String?
  eventType       String   @default("SEARCH") // SEARCH|FILTER|SORT|AUTOCOMPLETE|NL_PARSE|RESULT_CLICK|MAP_MOVE
  searchStateJson String?
  resultCount     Int?
  latencyMs       Int?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  searchQuery SearchQuery? @relation(fields: [queryId], references: [id])

  @@index([createdAt])
  @@index([queryId])
}

model AttributionTouchpoint {
  id                String   @id @default(cuid())
  sessionId         String
  leadId            String?
  touchType         String   @default("LANDING") // LANDING|PAGE_VIEW|SEARCH|ENTITY_VIEW|FORM_START|FORM_SUBMIT|CALL_CLICK|WHATSAPP_CLICK|BROCHURE_DOWNLOAD
  path              String?
  entityContextJson String?
  occurredAt        DateTime @default(now()) @db.Timestamptz(3)

  websiteSession WebsiteSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model Campaign {
  id          String   @id @default(cuid())
  utmCampaign String   @unique
  name        String
  utmSource   String?
  utmMedium   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

// First-party analytics event store (PART J taxonomy)
model AnalyticsEvent {
  id          String   @id @default(cuid())
  sessionId   String?
  userId      String?
  name        String // taxonomy: search, filter, property_view, favorite, ... (PART J)
  payloadJson String?
  path        String?
  locale      String   @default("en")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

