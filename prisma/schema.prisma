  messages       AiMessage[]
  turns          AiTurn[]
  toolExecutions AiToolExecution[]
  usage          AiUsage[]

  @@index([createdAt])
}

/** Durable request ownership and single-flight generation; no prompt text in the request record. */
model AiTurn {
  id              String   @id @default(cuid())
  conversationId  String
  clientRequestId String
  requestHash     String
  status          String   @default("PENDING") // PENDING|SUCCEEDED|FAILED
