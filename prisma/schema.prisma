  startedAt     DateTime  @default(now()) @db.Timestamptz(3)
  heartbeatAt   DateTime  @default(now()) @db.Timestamptz(3)
  stoppedAt     DateTime? @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, heartbeatAt])
}

model DeadLetterEvent {
  id           String    @id @default(cuid())
  jobKey       String
  sourceId     String? // outboxEventId | jobRunId
  payloadJson  Json      @db.JsonB
  error        String?
  attempts     Int       @default(0)
  replayedAt   DateTime? @db.Timestamptz(3)
  resolvedNote String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([jobKey])
  @@index([replayedAt])
}

model MediaProcessingJob {
  id         String    @id @default(cuid())
  mediaId    String
  spec       String    @default("derivatives") // derivatives|extract-meta|strip-exif
  status     String    @default("QUEUED") // QUEUED|RUNNING|SUCCEEDED|FAILED
  error      String?
  startedAt  DateTime? @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  media MediaAsset @relation(fields: [mediaId], references: [id])

  @@index([status])
}

// ============================================================
// C083–C086 Imports & data quality
// ============================================================

model ImportSource {
  id         String   @id @default(cuid())
  name       String   @unique
  sourceType String   @default("CSV") // CSV|JSON|API|XML
  configJson String? // mapping config (non-secret)
  url        String?
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  runs ImportRun[]
}

model ImportRun {
  id                 String    @id @default(cuid())
  datasetKind        String? // MARKET_TRANSACTION|MARKET_RENT; null for inventory imports
  appliedAt          DateTime? @db.Timestamptz(3)
  appliedBy          String?
  importSourceId     String
  status             String    @default("QUEUED") // QUEUED|RUNNING|SUCCEEDED|PARTIAL|FAILED|DRY_RUN
  inputFormat        String? // CSV|JSON; null for historical runs
  importMode         String    @default("SNAPSHOT") // SNAPSHOT|INCREMENTAL|WEBHOOK|HYBRID
  idempotencyKey     String?   @unique
  dryRun             Boolean   @default(false)
  adapterKey         String?
  adapterVersion     Int?
  sourceVersion      String?
  snapshotRetrievedAt DateTime? @db.Timestamptz(3)
  snapshotSha256     String?   @db.VarChar(64)
  snapshotRef        String? // private object-store key; never a public URL
  recordCursor       Int       @default(0)
  chunkSize          Int       @default(250)
  startedAt          DateTime? @db.Timestamptz(3)
  finishedAt         DateTime? @db.Timestamptz(3)
  recordsTotal       Int       @default(0)
  recordsCreated     Int       @default(0)
  recordsUpdated     Int       @default(0)
  recordsSkipped     Int       @default(0)
  recordsFailed      Int       @default(0)
  duplicatesDetected Int       @default(0)
  error              String?
  triggeredBy        String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  importSource ImportSource        @relation(fields: [importSourceId], references: [id])
  records      ImportRecord[]
  chunks       ImportRunChunk[]
  transactions MarketTransaction[]
  rents        MarketRent[]

  @@index([importSourceId, createdAt])
  @@index([datasetKind, createdAt])
  @@index([status, createdAt])
}

model ImportRunChunk {
  id                String    @id @default(cuid())
  importRunId       String
  chunkNumber       Int
  firstRecordNumber Int
  lastRecordNumber  Int
  recordsCount      Int       @default(0)
  status            String    @default("RUNNING") // RUNNING|SUCCEEDED|FAILED
  checksum          String    @db.VarChar(64)
  attempts          Int       @default(1)
  leaseToken        String?
  leaseExpiresAt    DateTime? @db.Timestamptz(3)
  startedAt         DateTime  @default(now()) @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  error             String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  importRun ImportRun @relation(fields: [importRunId], references: [id], onDelete: Restrict)
  records   ImportRecord[]

  @@unique([importRunId, chunkNumber])
  @@index([importRunId, status, chunkNumber])
  @@index([status, leaseExpiresAt])
}

model ImportRecord {
  id          String   @id @default(cuid())
  importRunId String
  recordNumber Int? // one-based position in the immutable input snapshot
  importRunChunkId String?
  entityKind  String   @default("PROPERTY") // PROPERTY|PROJECT|AGENT|MARKET_TRANSACTION|MARKET_RENT
  externalKey String?
  propertyId  String? // resolved local entity once created
  listingId   String?
  projectId   String?
  action      String   @default("CREATED") // CREATED|UPDATED|SKIPPED_DUPLICATE|SKIPPED_INVALID|FAILED|DRY_RUN
  checksum    String?
  issuesJson  String? // validation issues array
  rawJson     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  importRun ImportRun @relation(fields: [importRunId], references: [id])
  importRunChunk ImportRunChunk? @relation(fields: [importRunChunkId], references: [id], onDelete: SetNull)
  property  Property? @relation(fields: [propertyId], references: [id])
  listing   Listing?  @relation(fields: [listingId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])

  @@index([importRunId])
  @@unique([importRunId, recordNumber])
  @@index([entityKind, externalKey])
  @@index([propertyId])
  @@index([projectId])
}

model DataQualityIssue {
  id         String    @id @default(cuid())
  entityKind String
  entityId   String?
  severity   String    @default("WARNING") // INFO|WARNING|ERROR
  ruleKey    String // price_outlier|missing_media|missing_coords|stale_price|bedroom_mismatch
  message    String
  status     String    @default("OPEN") // OPEN|RESOLVED|IGNORED
  detectedAt DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  resolvedBy String?
  propertyId String?

  property Property? @relation(fields: [propertyId], references: [id])

  @@index([status, severity])
  @@index([entityKind, entityId])
}

// ============================================================
// C087–C088 Privacy
// ============================================================

model Consent {
  id            String    @id @default(cuid())
  subjectType   String    @default("VISITOR") // VISITOR|USER|CONTACT
  userId        String?
  contactId     String?
  sessionKey    String?
  purpose       String // ANALYTICS|MARKETING|NEWSLETTER|WHATSAPP|PERSONALIZATION|ESSENTIAL
  status        String    @default("GRANTED") // GRANTED|DENIED|WITHDRAWN
  policyVersion String    @default("2026-09-v1")
  capturedAt    DateTime  @default(now()) @db.Timestamptz(3)
  withdrawnAt   DateTime? @db.Timestamptz(3)
  source        String    @default("COOKIE_BANNER") // COOKIE_BANNER|FORM_CHECKBOX|ACCOUNT_SETTINGS
  evidenceJson  String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([subjectType, userId])
  @@index([subjectType, contactId])
  @@index([sessionKey])
}

model ExternalIdentity {
  id                String   @id @default(cuid())
  provider          String
  entityKind        String
  externalId        String
  canonicalEntityId String
  sourceUpdatedAt   DateTime? @db.Timestamptz(3)
  retrievedAt       DateTime @default(now()) @db.Timestamptz(3)
  metadataJson      String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@unique([provider, entityKind, externalId])
  @@index([entityKind, canonicalEntityId])
}

model DataSubjectRequest {
  id           String    @id @default(cuid())
  requestType  String    @default("EXPORT") // EXPORT|DELETE|RECTIFY|RESTRICT
  status       String    @default("RECEIVED") // RECEIVED|IN_PROGRESS|COMPLETED|REJECTED
  subjectEmail String
  contactId    String?
  userId       String?
  requestNote  String?
  resultJson   String?
  handledBy    String?
  completedAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])

  @@index([status])
}

// ============================================================
// C089–C091 Experimentation
// ============================================================

model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  description    String?
  isEnabled      Boolean  @default(false)
  rolloutPercent Int      @default(0)
  rulesJson      String?
  updatedBy      String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

model Experiment {
  id               String    @id @default(cuid())
  key              String    @unique
  name             String
  hypothesis       String?
  status           String    @default("DRAFT") // DRAFT|RUNNING|PAUSED|COMPLETED
  variantsJson     String? // [{key, weight, description}]
  primaryMetric    String?
  guardMetricsJson String?
  startedAt        DateTime? @db.Timestamptz(3)
  endedAt          DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  assignments ExperimentAssignment[]
}

model ExperimentAssignment {
  id           String   @id @default(cuid())
  experimentId String
  subjectKey   String // userId or sessionKey
  variantKey   String
  assignedAt   DateTime @default(now()) @db.Timestamptz(3)

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, subjectKey])
}

// ============================================================
// C092 Audit log
// ============================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorType      String   @default("USER") // USER|SYSTEM|AI|IMPORT
  actorId        String?
  action         String // entity.action e.g. property.publish
  resourceType   String
  resourceId     String
  beforeJson     String? // redacted snapshots
  afterJson      String?
  ipHash         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [actorId], references: [id])

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([createdAt])
}
