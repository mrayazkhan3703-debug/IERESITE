# Application environment: development, staging, or production.
APP_ENV=
# Public application origin, including scheme and port.
APP_URL=
# Number of known reverse-proxy hops that overwrite/append X-Forwarded-For (0 trusts no proxy headers).
TRUSTED_PROXY_HOPS=
# Generate a unique random secret of at least 32 characters; required when APP_ENV=production.
IP_PSEUDONYM_KEY=
# PostgreSQL connection URL.
DATABASE_URL=
# Session lifetime and cookie name.
AUTH_SESSION_TTL_HOURS=
AUTH_COOKIE_NAME=
AUTH_MFA_ENCRYPTION_KEY=
# Optional one-time development bootstrap identity; email/password must be set together.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=
# Search provider and optional external provider connection.
SEARCH_PROVIDER=
TYPESENSE_URL=
TYPESENSE_API_KEY=
# Map provider configuration.
MAP_PROVIDER=
MAPBOX_TOKEN=
NEXT_PUBLIC_MAP_PROVIDER=
NEXT_PUBLIC_MAPBOX_TOKEN=
# AI provider/model and safety limits.
AI_PROVIDER=mock
AI_MODEL=default
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_LIVE_ENABLED=false
AI_DAILY_REQUEST_LIMIT=25
AI_DAILY_TOKEN_LIMIT=60000
AI_MAX_PROMPT_CHARS=48000
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_TOOL_TURNS=
AI_RATE_LIMIT_PER_HOUR=
# CRM provider configuration; production provider is GHL.
CRM_PROVIDER=
CRM_LIVE_ENABLED=false
CRM_API_URL=
CRM_API_KEY=
CRM_WEBHOOK_SECRET=
# 64-character hex key for AES-256-GCM protected GHL OAuth credentials. Keep secret.
CRM_TOKEN_ENCRYPTION_KEY=
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Paste the HTTPS Installation URL generated in your HighLevel app settings.
GHL_INSTALL_URL=
GHL_REDIRECT_URI=
GHL_LOCATION_ID=
GHL_WEBHOOKS_ENABLED=false
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Email transport configuration.
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Dedicated worker configuration.
JOB_SCHEDULER_ENABLED=
JOB_INTERVAL_MS=
WORKER_HEALTH_PORT=
# Redis connection URL.
REDIS_URL=
# S3-compatible object storage configuration.
STORAGE_PROVIDER=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
# Analytics and request limits.
ANALYTICS_PROVIDER=
GA4_MEASUREMENT_ID=
RATE_LIMIT_GENERAL_PER_MIN=
RATE_LIMIT_AUTH_PER_MIN=
RATE_LIMIT_LEAD_PER_HOUR=
MEDIA_MAX_UPLOAD_MB=
